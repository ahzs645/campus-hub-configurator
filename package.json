{
  "name": "@firstform/campus-hub-configurator",
  "version": "0.2.0",
  "description": "Drag-and-drop configurator for Campus Hub displays",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/lib/config.ts",
    "./presets": "./src/lib/presets.ts",
    "./history": "./src/lib/dashboard-history.ts",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@firstform/campus-hub-engine": "^0.1.0",
    "@firstform/campus-hub-widget-sdk": "^0.1.0",
    "@firstform/json-url": "^4.1.0",
    "lucide-react": ">=0.400.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
